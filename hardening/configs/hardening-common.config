# =============================================================================
# Tier A - Architecture-neutral software memory-safety mitigations
# Always ON, unconditional. Apply with scripts/kconfig/merge_config.sh.
# Verified against Linux 7.1.0-rc6 (commit 979c294509f9).
# =============================================================================

# --- Memory initialization (kills uninitialized-memory infoleaks) ---
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y

# --- Slab / freelist hardening ---
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
# NOTE (SLAB_VIRTUAL keystone rule): the two separation features below are
# net-negative against cross-cache attacks WITHOUT address-space sequestering
# (SLAB_VIRTUAL), which is NOT upstream in 7.1-rc6. They are listed here per the
# spec but their security value is conditional on Tier B (see REPORT.md). They
# are individually harmless to spatial/temporal noise but do not, on their own,
# constitute a cross-cache mitigation.
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SLAB_BUCKETS=y
# Prevent cache merging (merging undermines any future type separation).
CONFIG_SLAB_MERGE_DEFAULT=n

# --- Copy / overflow hardening ---
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# --- Allocator / list integrity ---
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_DEBUG_LIST=y
CONFIG_BUG_ON_DATA_CORRUPTION=y

# --- Compiler-assisted, arch-neutral ---
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_VMAP_STACK=y

# --- Runtime self-test driver (Phase 1/2 verification via lkdtm) ---
# Built-in so the QEMU harness can trigger CFI/usercopy/list-corruption faults.
CONFIG_LKDTM=y

# -----------------------------------------------------------------------------
# Symbols intentionally NOT placed here (drift from the original spec):
#
#   CONFIG_GCC_PLUGIN_STACKLEAK / STACKLEAK_RUNTIME_DISABLE
#     STACKLEAK_RUNTIME_DISABLE is a boot/sysctl knob, not a Kconfig symbol.
#     GCC_PLUGIN_STACKLEAK requires GCC plugins and is mutually exclusive with
#     the Clang-based CFI build used for Tier C. Enable it only in GCC builds.
#     (Stack erasure is partly covered here by INIT_STACK_ALL_ZERO.)
# -----------------------------------------------------------------------------
