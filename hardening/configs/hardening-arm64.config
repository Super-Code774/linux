# =============================================================================
# Tier C - arm64 hardware / toolchain memory-safety mitigations
# Enable + enforce where the silicon/toolchain supports it. Each is a clean
# no-op at runtime on SoCs lacking the feature (detected via CPU ID regs).
# Verified against Linux 7.1.0-rc6 (commit 979c294509f9).
# Build with Clang/LLVM: make ARCH=arm64 LLVM=1
#   (PTR_AUTH_KERNEL + BTI_KERNEL require the LLVM toolchain in this tree.)
# =============================================================================

# --- Pointer Authentication (PAC) - ARMv8.3+ ---
CONFIG_ARM64_PTR_AUTH=y
# PAC for the kernel itself. Requires LLD/recent-LD and, under Clang,
# AS_HAS_CFI_NEGATE_RA_STATE.
CONFIG_ARM64_PTR_AUTH_KERNEL=y

# --- Branch Target Identification (BTI) - ARMv8.5+ ---
CONFIG_ARM64_BTI=y
# Kernel BTI depends on ARM64_PTR_AUTH_KERNEL and (in 7.1) a Clang toolchain
# (depends on !CC_IS_GCC) + CC_HAS_BRANCH_PROT_PAC_RET_BTI.
CONFIG_ARM64_BTI_KERNEL=y

# --- Privileged-access hardening ---
CONFIG_ARM64_E0PD=y   # E0PD: defeat unprivileged TLB-based meltdown-style attacks
CONFIG_ARM64_EPAN=y   # Enhanced Privileged Access Never (exec-only PAN)

# --- Memory Tagging Extension (MTE) - ARMv8.5+ ---
# Requires ARM64_AS_HAS_MTE + AS_HAS_ARMV8_5 (assembler support).
CONFIG_ARM64_MTE=y
# Production MTE = KASAN_HW_TAGS. Runtime mode is controlled at boot:
#   kasan=on/off, kasan.mode=sync|async|asymm  (default below).
# Sync mode is strongest (precise) but costliest; async is the usual prod
# default. We ship KASAN_HW_TAGS built-in and leave mode selection to boot args
# so the perf/availability tradeoff is an operator decision (see REPORT.md).
CONFIG_KASAN=y
CONFIG_KASAN_HW_TAGS=y

# --- Guarded Control Stack (GCS) - ARMv9.4 / FEAT_GCS ---
CONFIG_ARM64_GCS=y

# --- Forward-edge control-flow integrity (Clang kCFI) ---
CONFIG_CFI=y

# --- Address-space layout randomization ---
CONFIG_RANDOMIZE_BASE=y
