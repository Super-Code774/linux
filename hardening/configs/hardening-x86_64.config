# =============================================================================
# Tier C - x86_64 hardware / toolchain memory-safety mitigations
# Enable + enforce where the silicon/toolchain supports it.
# Verified against Linux 7.1.0-rc6 (commit 979c294509f9).
# Build with a Clang toolchain: make LLVM=1 (required for CFI).
# =============================================================================

# --- Forward-edge control-flow integrity ---
# Symbol drift: CONFIG_CFI_CLANG is now a *transitional* alias in 7.1; the live
# symbol is CONFIG_CFI (depends on ARCH_SUPPORTS_CFI + clang -fsanitize=kcfi).
CONFIG_CFI=y

# Hardware Indirect Branch Tracking (def_bool y on capable HW; pin it on).
# Requires CC_HAS_IBT + objtool. Selects X86_CET.
CONFIG_X86_KERNEL_IBT=y
# FineIBT is selected automatically when CFI + X86_KERNEL_IBT are both on and
# is chosen at boot by default (CFI_AUTO_DEFAULT=y, set via olddefconfig).

# --- CET user shadow stack (return-address protection for userspace) ---
# Requires AS_WRUSS. Selects X86_CET. CPUs >= 2020.
CONFIG_X86_USER_SHADOW_STACK=y

# --- SMEP/SMAP/UMIP supervisor-mode access prevention ---
# Symbol drift: CONFIG_X86_SMAP was REMOVED; SMEP/SMAP are now unconditionally
# enabled on capable hardware with no Kconfig knob. Nothing to set.
CONFIG_X86_UMIP=y

# --- Address-space layout randomization ---
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y

# -----------------------------------------------------------------------------
# Not available in 7.1-rc6 (do NOT set; would silently do nothing or fail):
#   CONFIG_X86_KERNEL_SHADOW_STACK - kernel-mode CET shadow stack is not merged.
#     Only userspace shadow stack (X86_USER_SHADOW_STACK) exists. X86_CET is the
#     umbrella symbol, auto-selected; it is not directly user-settable.
# -----------------------------------------------------------------------------
