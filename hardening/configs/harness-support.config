# Verification-support options (NOT hardening features). Merged by build.sh so
# the QEMU harness can read the running config and drive lkdtm. Keep these out
# of production hardening fragments.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y          # exposes /proc/config.gz for in-VM verification
CONFIG_DEBUG_FS=y               # lkdtm trigger interface lives in debugfs
CONFIG_BLK_DEV_INITRD=y
